# Panel de Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo para scripts (npm run seed). Ignora el RLS: nunca exponer al navegador
# ni subir al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Panel de Supabase → Settings → Database → Connection string → URI
# Usa el "Session pooler" y sustituye [YOUR-PASSWORD] por tu contraseña.
# Sólo para npm run migrate.
SUPABASE_DB_URL=
